---
// Inline SVG icon. Used wherever an icon is shown (header, menu, profile card, rails).
import type { IconName } from '@config';

interface Props {
  name: IconName;
  class?: string;
}
// Astro.props is how an .astro component receives its props.
const { name, class: className } = Astro.props;

// import.meta.glob (a Vite feature) loads every matching file at build time.
// `?raw` gives each SVG as a string, so it can be inlined and take the text colour.
const icons = import.meta.glob<string>('@assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const svg = Object.entries(icons).find(([path]) => path.endsWith(`/${name}.svg`))?.[1];
if (!svg) throw new Error(`Unknown icon: ${name}`);
---

<!-- set:html inserts the string as raw HTML instead of escaping it. Safe: the SVGs are our own files. -->
<i class={className} set:html={svg} />
