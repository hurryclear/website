---
// Main navigation. Used by Header.astro. Desktop: inline links. Mobile: hamburger opens a floating panel.
import Icon from '@components/Icon.astro';
import { MAIN_NAV } from '@config';
import { t } from '../i18n/ui';

// Astro.url is the URL of the page being built, so each page can mark its own active link.
const path = Astro.url.pathname;
// Active = exact match, or (for sections like /posts/hello) the path starts with the href.
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<nav class="relative">
  <button
    id="menu-toggle"
    type="button"
    aria-label={t('nav.openMenu')}
    aria-expanded="false"
    aria-controls="menu"
    class="inline-flex items-center p-2 rounded-lg text-slate-800 dark:text-slate-200 md:hidden"
  >
    <Icon name="menu-2" class="block h-6 w-6" />
  </button>

  {/* Mobile: a floating panel with its own surface + border. Desktop (md+): a plain inline row. */}
  <div id="menu" class="hidden absolute right-0 top-12 z-50 md:static md:block md:top-0">
    <ul
      class="flex flex-col md:flex-row items-stretch md:items-center gap-y-1 md:gap-y-0
             py-2 md:py-0 px-2 md:px-0 text-sm font-medium
             rounded-lg md:rounded-none
             bg-slate-50 md:bg-transparent dark:bg-gray-800 md:dark:bg-transparent
             border border-slate-200 md:border-0 dark:border-gray-700
             shadow-lg md:shadow-none"
    >
      {
        MAIN_NAV.map((item) => (
          <li>
            <a
              href={item.href}
              title={item.label}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={['block px-3 py-2 hover:text-emerald-600', isCurrent(item.href) && 'text-emerald-600']}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  // A plain <script> in an .astro file is bundled by Astro and runs in the browser (not at build time).
  const button = document.getElementById('menu-toggle');
  const panel = document.getElementById('menu');

  function setOpen(open: boolean) {
    panel?.classList.toggle('hidden', !open);
    button?.setAttribute('aria-expanded', String(open));
  }

  button?.addEventListener('click', (e) => {
    e.stopPropagation(); // keep the document click handler below from closing it again at once
    setOpen(panel?.classList.contains('hidden') ?? false);
  });
  document.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      setOpen(false);
      button?.focus(); // the panel just vanished, so give focus back to the toggle
    }
  });
</script>
