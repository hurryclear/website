---
// Astro builds this file to dist/404.html; most static hosts serve it for unknown URLs.
import BaseLayout from '@layouts/BaseLayout.astro';
import { t } from '../i18n/ui';
---

{/* rail="none": a 404 has no sidebar, so the content takes the full width */}
<BaseLayout title={t('404.title')} rail="none" noCanonical>
  <div class="py-16 text-center">
    <p class="text-sm font-semibold text-emerald-600">404</p>
    <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">{t('404.title')}</h1>
    <p class="mt-4 text-slate-500 dark:text-slate-400">{t('404.sorry')}</p>
    <a href="/" class="inline-block mt-8 text-sm font-medium text-emerald-600 hover:text-emerald-500">
      {t('404.home')} &rarr;
    </a>
  </div>
</BaseLayout>
