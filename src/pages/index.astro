---
// Home page: renders src/content/pages/home.md. No heading, as on the old site.
import { getEntry, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Prose from '@components/Prose.astro';

const entry = (await getEntry('pages', 'home'))!;
// render() turns the Markdown body into a <Content /> component.
const { Content } = await render(entry);
---

<BaseLayout sourcePath={entry.filePath}>
  <article>
    <Prose><Content /></Prose>
  </article>
</BaseLayout>
