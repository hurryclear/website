---
// Search placeholder: the page and input are in place, but nothing is wired up yet.
// TODO(hur): make search work. Two options:
//   1. Build a JSON index with an Astro endpoint (src/pages/search.json.ts) and query it
//      from a React island using Fuse.js.
//      Docs: https://docs.astro.build/en/guides/endpoints/
//   2. Use Pagefind, which indexes the built HTML and ships its own UI.
//      Docs: https://pagefind.app/
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import { t } from '../i18n/ui';
---

<BaseLayout title={t('search.title')} rail="none">
  <div class="max-w-2xl">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">{t('search.title')}</h1>
    <div class="mt-6 flex items-center border-b border-slate-300 dark:border-gray-700">
      <i class="h-5 w-5 flex-none text-slate-400"><Icon name="search" /></i>
      <!-- disabled until search exists; aria-label because there is no visible <label> -->
      <input
        type="text"
        id="search-input"
        disabled
        aria-label={t('search.title')}
        class="flex-1 min-w-0 bg-transparent px-3 py-2 text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:outline-none disabled:cursor-not-allowed"
      />
    </div>
    <p class="mt-8 text-slate-500 dark:text-slate-400">{t('search.comingSoon')}</p>
  </div>
</BaseLayout>
